<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Lombok-generated code triggers false positives for these patterns. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Records expose their components by contract. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Source name="~.*\.java"/>
  </Match>
</FindBugsFilter>
