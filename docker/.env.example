# Copy to `.env` (in the same folder as docker-compose.yml) and adjust values.
# The .env file is picked up automatically by docker-compose.

# --- PostgreSQL ------------------------------------------------------------
POSTGRESQL_USERNAME=challenge_user
POSTGRESQL_PASSWORD=challenge_password
POSTGRESQL_DATABASE=challenge

# --- MinIO -----------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin_password
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_admin_password
MINIO_BUCKET=document-bucket

# --- Document Management Service ------------------------------------------
APP_PORT=8080
